{
  // Type-checks the frontend (npm run typecheck); Vite, Vitest and Node only strip the types.
  // scripts/*.mjs stay JavaScript and are not checked.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
