# Base URL of the backend REST API. Relative URLs go through the Vite dev/preview proxy
# (/api -> http://127.0.0.1:8000). Use an absolute URL only when the backend allows this origin
# via CORS (TWB_CORS_ORIGINS) and exposes the Content-Disposition and X-Request-ID headers.
VITE_API_BASE_URL=/api/v1
